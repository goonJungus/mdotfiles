

ff() {
  pokemon-colorscripts -r
  echo
  dripfetch "$@"
}

#: Completion system + fzf-tab fuzzy completion (brew install fzf fzf-tab)
autoload -Uz compinit
compinit
if [ -f "$(brew --prefix)/share/fzf-tab/fzf-tab.plugin.zsh" ]; then
  source "$(brew --prefix)/share/fzf-tab/fzf-tab.plugin.zsh"
fi

#: fzf keybindings (after brew install fzf, run $(brew --prefix)/opt/fzf/install)
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

#: Smarter completion behavior
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:*' use-fzf-default-opts yes

#: Autocomplete from history (brew install zsh-autosuggestions)
if [ -f "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

#: Syntax highlighting - must be last (brew install zsh-syntax-highlighting)
if [ -f "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
  source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

#: Lavender ASCII prompt (matches SketchyBar theme)
autoload -Uz vcs_info
precmd_functions+=(vcs_prompt_update)
vcs_prompt_update() { vcs_info }

zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %F{#bf5af2}(%b%u%c)%f'
zstyle ':vcs_info:git:*' actionformats ' %F{#bf5af2}(%b|%a%u%c)%f'
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' unstagedstr '*'
zstyle ':vcs_info:git:*' stagedstr '+'

setopt PROMPT_SUBST

PROMPT='%F{#bf5af2}╭─%f %B%F{#e6e6e6}%n@%m%f%b %F{#6a6a6a}::%f %F{#d78fff}%~%f${vcs_info_msg_0_}
%F{#bf5af2}╰─➜%f '
RPROMPT='%F{#6a6a6a}%*%f'

#: Show dripfetch on every terminal open
dripfetch

. "$HOME/.local/bin/env"

# Free AI API keys for Pi (fill in after signing up — then open a new terminal)

# --- jdotfiles: update-all (bare brew updates everything) ---
brew() {
    if [ $# -eq 0 ]; then
        command brew update
        command brew upgrade
        command brew upgrade --cask
    else
        command brew "$@"
    fi
}

# API keys live outside git
[[ -f ~/.zshrc_secrets ]] && source ~/.zshrc_secrets
